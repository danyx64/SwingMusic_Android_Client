<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ScrollView
        android:id="@+id/loginPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/loginSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Swing Music on your server"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_alt"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="IP or hostname">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/hostInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:text="192.168.1.10"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/portInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true"
                                android:text="1970"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/httpsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="HTTPS"
                            android:textOff=""
                            android:textOn=""
                            app:showText="false" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Username">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/usernameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Password"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="Connect"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <TextView
                        android:id="@+id/loginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/coral"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/appPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/foldersButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Home"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playlistsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Playlists"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Search"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/albumsButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Albums"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search tracks"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/queryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runSearchButton"
                android:layout_width="58dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="0dp"
                android:text="Go"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textSize="14sp"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_panel_background"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Theme"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLightButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Default"
                    android:textAllCaps="false"
                        android:letterSpacing="0"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDarkButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Dark"
                    android:textAllCaps="false"
                        android:letterSpacing="0"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeOledButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="OLED"
                    android:textAllCaps="false"
                        android:letterSpacing="0"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/languageSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Language"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/languageButtonRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageSystemButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="System"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageItalianButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="94dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Italiano"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageEnglishButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="90dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="English"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageSpanishButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Espanol"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageFrenchButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="96dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Francais"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageGermanButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Deutsch"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languagePortugueseButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="106dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="Portugues"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textSize="13sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/colorSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Colors"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/accentButtonRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentDefaultButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:text="Default"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentSkyButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="76dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Sky"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentMintButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="76dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Mint"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentPinkButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="76dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Pink"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentGoldButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="76dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Gold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/accentVioletButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="82dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Violet"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/customColorButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Custom"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/librarySectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Library"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homePathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="Home path: loading"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rescanButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Rescan library"
                android:textAllCaps="false"
                        android:letterSpacing="0"
                app:cornerRadius="18dp" />

            <TextView
                android:id="@+id/accountSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Account"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/accountNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="New password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveAccountButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Save account"
                    android:textAllCaps="false"
                        android:letterSpacing="0"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Logout"
                    android:textAllCaps="false"
                        android:letterSpacing="0"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pathText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/playCollectionButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_button_primary"
                android:contentDescription="Play section"
                android:src="@drawable/ic_play"
                android:tint="@color/surface"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newPlaylistButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="New"
                android:textAllCaps="false"
                        android:letterSpacing="0"
                android:visibility="gone"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="108dp" />

        <LinearLayout
            android:id="@+id/playerBar"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/player_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <dev.swingmusic.android.RoundedImageView
                    android:id="@+id/miniCoverImage"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/panel_background"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/miniCoverFallback"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@color/teal"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowPlayingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Nothing playing"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nowPlayingSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/miniSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="2dp"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button_primary"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_play"
                android:tint="@color/surface" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/closePlayerButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/icon_button_secondary"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

        <dev.swingmusic.android.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <dev.swingmusic.android.RoundedImageView
                android:id="@+id/sheetCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_background"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/sheetCoverFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/teal"
                android:textSize="28sp"
                android:textStyle="bold" />
        </dev.swingmusic.android.SquareFrameLayout>

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Nothing playing"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/sheetAlbum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sheetMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/gold"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sheetSeekBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheetElapsedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sheetRemainingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="-0:00"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_button_secondary"
                android:contentDescription="Shuffle"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/icon_button_primary"
                android:contentDescription="Previous"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/surface" />

            <ImageButton
                android:id="@+id/sheetPlayPauseButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/icon_button_primary"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_play"
                android:tint="@color/surface" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/icon_button_primary"
                android:contentDescription="Next"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/surface" />

            <ImageButton
                android:id="@+id/repeatButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/icon_button_secondary"
                android:contentDescription="Repeat"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
