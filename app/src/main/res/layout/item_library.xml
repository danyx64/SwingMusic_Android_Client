<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="1dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp">

            <dev.swingmusic.android.RoundedImageView
                android:id="@+id/coverImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/panel_background"
                android:clipToOutline="true"
                android:contentDescription="Cover"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/typeMark"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:textColor="@color/teal"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/primaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/secondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/metaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="82dp"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/rowPlayButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/icon_button_primary"
            android:contentDescription="Play"
            android:src="@drawable/ic_play"
            android:tint="@color/surface"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
